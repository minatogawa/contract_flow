# Server
PORT=3140
APP_URL=http://localhost:3140
SESSION_SECRET=troque-por-uma-string-grande

# Free usage gates
FREE_QUESTION_LIMIT=30
FREE_DOCUMENT_LIMIT=10

# LLM provider: mock, gemini or deepseek
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Mercado Pago Checkout Pro
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_API_BASE=https://api.mercadopago.com
MP_CHECKOUT_MODE=sandbox
MP_PREMIUM_AMOUNT=249000
MP_PREMIUM_CURRENCY=CLP
MP_PREMIUM_TITLE=ContractFlow Premium

# Use true apenas se quiser enviar callbacks mesmo com APP_URL em localhost.
MP_FORCE_CALLBACKS=false
